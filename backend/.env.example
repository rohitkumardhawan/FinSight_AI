# =================================================================
# FinSight AI — Backend Environment Configuration (.env.example)
# Copy this file to backend/.env and populate with your credentials.
# NEVER commit your actual .env file with secrets to Git!
# =================================================================

# Server & Environment
ENVIRONMENT=development
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# Security & Admin Authentication
ADMIN_API_KEY=dev_admin_secret_key_change_in_production

# Optional Production Observability (Sentry)
SENTRY_DSN=

# PostgreSQL Neon Database Configuration (Phase 2-4 Canonical Storage)
DATABASE_URL=postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-sample.us-east-2.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production
NEON_BRANCH_ID=

# Google Gemini API Key (Phase 4 AI Intelligence & RAG Embeddings)
GEMINI_API_KEY=

# SEC EDGAR Financial Intelligence (10-K facts for US Equities)
SEC_USER_AGENT=FinSightAI research@finsight.local
