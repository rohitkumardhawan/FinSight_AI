# =================================================================
# FinSight AI — Environment Variables Example
# Copy this file to .env and fill in your values.
# NEVER commit your actual .env file with secrets to Git!
# =================================================================

# PostgreSQL Neon Database Configuration (Phase 2 Data Persistence)
DATABASE_URL=
DATABASE_URL_UNPOOLED=
NEON_BRANCH=production
NEON_BRANCH_ID=

# Backend Server Configuration
BACKEND_PORT=8000
ENVIRONMENT=development

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000/api
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000
FRONTEND_ORIGIN=http://localhost:3000

# Security & Admin Authentication
ADMIN_API_KEY=dev_admin_secret_key_change_in_production

# Optional Production Observability (Sentry)
SENTRY_DSN=

# Google Gemini API Key (Phase 4 AI Intelligence & RAG Embeddings)
GEMINI_API_KEY=

# SEC EDGAR Financial Intelligence (10-K facts for US Equities)
SEC_USER_AGENT=FinSightAI research@finsight.local
